# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, NEVER exposed to the browser.
# Keep this out of anything committed with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Site URL, used for auth redirect links in magic-link emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — Premium is a one-time purchase (mode: "payment"), not a
# subscription. Price ID is server-only; it's never read in the browser,
# so it does NOT need a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_1TzLWEADwn8VA4svmKnNcsWq
