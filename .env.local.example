# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, NEVER exposed to the browser.
# Keep this out of anything committed with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Site URL, used for auth redirect links in magic-link emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (added when we wire up billing — leave blank for now)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ID_ANNUAL=
